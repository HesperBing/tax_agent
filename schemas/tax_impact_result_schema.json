{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tax-agent.local/schemas/tax_impact_result_schema.json",
  "title": "Tax Impact Result Module v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tax_case_id", "tax_impact_results"],
  "properties": {
    "tax_case_id": { "$ref": "common_defs_schema.json#/$defs/identifier" },
    "tax_impact_results": { "type": "array", "items": { "$ref": "#/$defs/tax_impact_result" } }
  },
  "$defs": {
    "tax_impact_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tax_impact_result_id", "impact_group_id", "tax_type", "substance_code", "target_judgement_item", "tax_base_amount", "expected_tax_amount", "actual_tax_amount", "tax_difference_amount", "currency", "related_judgement_resolution_ids", "fact_basis_ids", "legal_basis_ids"],
      "properties": {
        "tax_impact_result_id": { "$ref": "common_defs_schema.json#/$defs/identifier" },
        "impact_group_id": { "$ref": "common_defs_schema.json#/$defs/identifier" },
        "tax_type": { "$ref": "common_defs_schema.json#/$defs/tax_type" },
        "substance_code": { "oneOf": [{ "$ref": "common_defs_schema.json#/$defs/registry_code" }, { "type": "null" }] },
        "target_judgement_item": { "$ref": "common_defs_schema.json#/$defs/registry_code" },
        "tax_base_amount": { "$ref": "common_defs_schema.json#/$defs/nullable_nonnegative_number" },
        "expected_tax_amount": { "$ref": "common_defs_schema.json#/$defs/nullable_nonnegative_number" },
        "actual_tax_amount": { "$ref": "common_defs_schema.json#/$defs/nullable_nonnegative_number" },
        "tax_difference_amount": { "$ref": "common_defs_schema.json#/$defs/nullable_number" },
        "currency": { "$ref": "common_defs_schema.json#/$defs/nullable_currency" },
        "related_judgement_resolution_ids": { "$ref": "common_defs_schema.json#/$defs/id_array" },
        "fact_basis_ids": { "$ref": "common_defs_schema.json#/$defs/fact_basis_ids" },
        "legal_basis_ids": { "$ref": "common_defs_schema.json#/$defs/legal_basis_ids" }
      }
    }
  }
}
